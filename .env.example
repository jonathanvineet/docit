# Copy to .env (app root). Restart `npx expo start` after changes.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Laptop running backend/ (same Wi-Fi as the phone). Leave empty to use the
# Expo dev-server host automatically.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_SENSOR_WS_URL=

# Optional Google-compatible Places key (gomaps.pro). Without it, nearby
# hospitals come from OpenStreetMap (no key needed).
EXPO_PUBLIC_GOMAPS_API_KEY=

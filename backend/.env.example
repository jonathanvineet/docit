# Copy to backend/.env and fill in what you have. Everything is optional:
# without values the servers run in offline/simulated mode.

# --- Sensor hub (index.js, port 3000) ---
SENSOR_PORT=3000
# MQTT broker the wearable publishes to (e.g. HiveMQ Cloud). Leave MQTT_HOST empty
# to use the built-in simulator instead.
MQTT_HOST=
MQTT_PORT=8883
MQTT_PROTOCOL=mqtts
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=sensors/data
# Force the simulator even when MQTT is configured
SENSOR_SIMULATE=0

# --- Alert server (backend.js, port 3001) ---
ALERTS_PORT=3001
# Twilio: when all three are set, SOS places real calls/SMS; otherwise simulated
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 numbers, e.g. +919876543210,+919812345678
EMERGENCY_CALL_TO=
EMERGENCY_SMS_TO=
# Set to "off" to skip OpenStreetMap reverse geocoding (coordinates + map link only)
REVERSE_GEOCODE=on

# --- Chatbot ---
# Claude API key enables AI answers; without it the app uses its offline first-aid guide
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
